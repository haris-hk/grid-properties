# Copy to .env.local for `vercel dev`, and set the same values in
# Vercel → Settings → Environment Variables for deployed environments.

# Required to actually deliver inquiries. Get a key at https://resend.com
RESEND_API_KEY=

# Required. Where inquiries are delivered. Comma-separate for multiple inboxes.
INQUIRY_TO=

# Optional. A verified sender on your own domain.
# Without this, mail is sent from onboarding@resend.dev, which Resend only
# delivers to the address that owns the Resend account.
INQUIRY_FROM=
